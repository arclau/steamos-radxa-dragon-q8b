# SteamOS ARM 内核需求片段 —— Radxa Dragon Q8B / SC8280XP
#
# 来源：改编自 hashtagbasit/SteamOS-ARM-Handhelds 的
#   external-and-mods/kernel-common/steamos.config（通用片段）
#   + external-and-mods/kernel-sm8350/steamos.config 里的通用输入/手柄项。
# 每行一个 CONFIG；=y / =m / =n 或一个值。
#
# 用法：
#   cd <本仓库根>（或直接跑 config/apply-steamos-fragment.sh）
#   while IFS= read -r l; do case "$l" in ''|\#*) continue;; esac; \
#     k="${l%%=*}"; v="${l#*=}"; \
#     case "$v" in y) upstream/radxa-kernel/scripts/config --file build/kernel/.config --enable "${k#CONFIG_}";; \
#       m) upstream/radxa-kernel/scripts/config --file build/kernel/.config --module "${k#CONFIG_}";; \
#       n) upstream/radxa-kernel/scripts/config --file build/kernel/.config --disable "${k#CONFIG_}";; \
#       \"*) upstream/radxa-kernel/scripts/config --file build/kernel/.config --set-str "${k#CONFIG_}" "$(eval echo "$v")";; \
#       *) upstream/radxa-kernel/scripts/config --file build/kernel/.config --set-val "${k#CONFIG_}" "$v";; esac; \
#   done < config/steamos-sc8280xp.config
#   make -C upstream/radxa-kernel O=$PWD/build/kernel ARCH=arm64 olddefconfig
#
# 注：手写手柄专有项（KONKR MCU、Nubia 面板、SM8xxx 时钟）不适用本板，已剔除。

# /etc 与 /var 的 overlay 由 SteamOS 在早期挂载，必须内建，不能等模块自动加载。
CONFIG_OVERLAY_FS=y

# InputPlumber 的 deck-uhid 需要内核 hid-steam 绑定到虚拟 Valve 手柄，Steam 才认成真 Deck 手柄。
CONFIG_HID_STEAM=m
CONFIG_STEAM_FF=y

# Proton / FEX：快速 NT 同步原语（Wine ntsync）。
CONFIG_NTSYNC=m

# 蓝牙 HFP / 用 RFCOMM 的手柄（Radxa defconfig 默认关）。
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m

# Steam 运行时 / flatpak 容器。
CONFIG_EROFS_FS=m
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y

# SteamOS 单元用到的 systemd 资源控制。
CONFIG_CFS_BANDWIDTH=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_CGROUP_MISC=y

# SteamOS 用 zram-generator 配 zram。
CONFIG_ZRAM=m
CONFIG_ZSWAP=y

# systemd cgroup / IP 过滤用 BPF JIT。
CONFIG_BPF_JIT_ALWAYS_ON=y

# iwd（SteamOS 默认 WiFi 后端）早期用 AF_ALG；overlay 虽固定用 wpa_supplicant，但保持 iwd 可用。
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_AEAD=y

# LED pattern trigger（SBC 可选，保留以防板上有可控 LED）。
CONFIG_LEDS_TRIGGER_PATTERN=m

# 每线程利用率钳位：让游戏线程（uclamp.min）优先上大核。
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
# 默认调频器：对齐 Frame（PERFORMANCE）。
# ⚠️ 取舍：Q8B 若被动散热，performance 常驻高频可能过热/降频。上机后若温度异常，
#   运行时改回：echo schedutil > /sys/devices/system/cpu/cpufreq/policy*/scaling_governor
#   （或把下面两行换回 CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y 重建）。
# 注：CPU_FREQ_DEFAULT_GOV_* 是 Kconfig choice，必须同时显式关掉 schedutil 才生效。
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=n

# 抢占模型：对齐 SteamOS Frame 内核 = full preempt（低延迟）。
# 依据：从 SteamOS rootfs 的 /boot/Image-6.18.0-* 用 IKCONFIG 提取 Frame 内嵌 config，
#   实测 CONFIG_PREEMPT=y 且 CONFIG_PREEMPT_DYNAMIC is not set、PREEMPT_LAZY is not set。
# 本板 radxa defconfig 默认是 7.x 新的 PREEMPT_LAZY（调度器控制式，对 SCHED_NORMAL
#   更不急于抢占）→ 对游戏帧延迟不利，故显式改为 full preempt。
# 注：早前曾称"这是与 Frame diff 后唯一实质差异"——**不完整**（2026-10-03 更正）。
#   完整集合 diff 见本文件末「系统兼容性」一节。
CONFIG_PREEMPT=y
CONFIG_PREEMPT_LAZY=n
CONFIG_PREEMPT_DYNAMIC=n

# 追踪文件系统（/sys/kernel/tracing）。Frame 用户态需要它：
# - mangoapp（性能叠加）经 tracefs 读 Adreno 占用/显存，缺了直接 "failed to create instance" 中止；
# - steamos-manager -r 建 /sys/kernel/tracing 时 EPERM，会把 Game Mode 卡住约 3 分钟。
#
# 注：基线用 CONFIG_ENABLE_DEFAULT_TRACERS=y 来 `select TRACING`（它的 ROCKNIX base 没开 TRACING）。
# 本板 radxa defconfig 已自带 TRACING=y + TRACEPOINTS=y，tracefs 由
#   upstream/radxa-kernel/fs/tracefs/Makefile: `obj-$(CONFIG_TRACING) += tracefs.o`
# 构建，需求已满足。而 ENABLE_DEFAULT_TRACERS 依赖 `!GENERIC_TRACER`，与本板
# FUNCTION_TRACER=y（→ GENERIC_TRACER=y）互斥，故**不设**——设了也会被 Kconfig 拒绝。
CONFIG_FTRACE=y
CONFIG_TRACING=y
CONFIG_TRACEPOINTS=y

# 现代 Wine/Proton 用 futex_waitv 系统调用做等待。注：本内核里 futex_waitv 由
#   upstream/radxa-kernel/kernel/futex/syscalls.c: SYSCALL_DEFINE5(futex_waitv, ...)
# 无条件提供（无 Kconfig 开关），CONFIG_FUTEX=y 即可，无需额外设置。

# Binder：给 Lepton（Valve 的 Android 层，Steam app 3029110）。其容器自己挂 binderfs 并
# 把设备重命名为 anbox-{binder,hwbinder,vndbinder}，故须是 binderfs 的默认设备名。同 Frame 内核。
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="anbox-binder,anbox-hwbinder,anbox-vndbinder"

# s2idle：唤醒原因（/sys/power/pm_wakeup_irq）、suspend_stats、每设备挂起/恢复耗时，
# 让失败的睡眠能说清原因。本板无电池，休眠调试尤其需要。
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y

# --- 输入 / 手柄（来自 kernel-sm8350/steamos.config 的通用项）---
# 蓝牙手柄走 BLE HID（HOG）；Steam Input 虚拟手柄与 steamos-manager 无障碍服务用 uinput，
# 缺 INPUT_UINPUT 会让该守护进程失败并挂 180s，把 Game Mode 拖慢约 3 分钟。
CONFIG_BT_LE=y
CONFIG_UHID=m
CONFIG_INPUT_UINPUT=m
CONFIG_HID_PLAYSTATION=m
CONFIG_PLAYSTATION_FF=y
CONFIG_HID_NINTENDO=m
CONFIG_NINTENDO_FF=y
CONFIG_HID_MICROSOFT=m
# USB / 2.4GHz 接收器手柄的 XInput 模式（xpad 绑定厂商类接口）。
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=m
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
CONFIG_INPUT_JOYDEV=m

# ─────────────────────────────────────────────────────────────────────────
# 系统兼容性：SteamOS rootfs(6.18) 跑在我们的 7.0.11 内核上（实测）
# 依据：与 Frame 内嵌 config（ref/frame-6.18.config）做集合级 diff 后，筛出真正相关的差异。
# 过滤掉的伪差异：其它 SoC（SM8650/8550）、遗留 FS、分区表、调试项、Valve 私有符号
#   （DRM_PANEL_DECKARD/VRCONSOLE/QCOM_SCM_ADDON，radxa 内核本就没有）。
# 判定不做：qcom SMSM/SPM/OCMEM/SMD_RPM —— sc8280xp 不需要（msm 用 RPMH，OCMEM 是可选的旧 GPU 依赖）。
# ─────────────────────────────────────────────────────────────────────────

# sched_ext：SteamOS 带 scx_lavd（/usr/bin/scx_lavd + scx.service + /etc/default/scx，
#   SCX_SCHEDULER=scx_lavd）。scx.service 有 ConditionPathIsDirectory=/sys/kernel/sched_ext，
#   缺此项则服务被跳过（非失败），但 Valve 的性能调度器不起作用。
CONFIG_SCHED_CLASS_EXT=y
# BTF / BPF CO-RE：scx_lavd 的 BPF 程序需要 vmlinux BTF 才能做 CO-RE 重定位。
#   前提 DEBUG_INFO=y / DWARF5 / PAHOLE_VERSION=125 本板已满足，开它不挂构建。
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y

# 手柄力反馈 / HID 设备节点（Frame 有，本板 radxa defconfig 默认关）。
CONFIG_HID_PID=y
CONFIG_USB_HIDDEV=y

# Android wakelock（/sys/power/wake_lock）：qcom/ARM 用户态可能使用，与 Frame 对齐。
CONFIG_PM_WAKELOCKS=y

# 空闲 tick：对齐 Frame 的 NO_HZ_IDLE。本板 radxa defconfig 误开了 NO_HZ_FULL
#   （full dynticks，HPC 取向），非桌面/掌机取向，显式改回。
CONFIG_NO_HZ_IDLE=y
CONFIG_NO_HZ_FULL=n
